s = input("Enter a sentense: ")

digits = 0
uppercase = 0
lowercase = 0

for ch in s:
    
    if ch.isdigit():
        digits += 1
        
    elif ch.isupper():
        uppercase += 1
        
    elif ch.islower():
        lowercase += 1 

print("Digits = " , digits)
print("Upper-Case Chariters = " , uppercase)
print("Lower-Case Charicters = " , lowercase)
