num1 = float(input ("Enter Value of First Number: "))
num2 = float(input ("\nEnter value of Second Number: "))

op = input("\nSelect an Oppration '+' , '-' , '*' and '/': ")

if op == '+' :
    print("\nResult: " , num1 + num2 )
    
elif op == '-' :
    print("\nResult:" , num1 - num2 )
    
elif op == '*' :
    print("\nResult: " , num1 * num2 )
    
elif op == '/' :
    if num2 != 0 :
       print("\nResult: " , num1 / num2 )
    else :
        print ("\nError !: Dinominator Zero '0'.")
    
else :
  print("\nError !: Invalid Input")
